# gemini | groq | fake
LLM_PROVIDER=gemini
# Google AI Studio key: https://aistudio.google.com/apikey (free tier, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq: https://console.groq.com/keys (free tier, no card)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Only for running outside Docker; docker compose always uses its own db service.
# e.g. postgresql://recipe:recipe@localhost:5432/recipe
DATABASE_URL=
# Host port for the API (docker compose), default 8000
API_PORT=8000
